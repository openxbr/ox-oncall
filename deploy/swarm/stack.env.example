# Variáveis do deploy (NÃO secretas). Copiar para stack.env, ao lado do stack file, e carregar
# antes do deploy:  set -a; . ./stack.env; set +a
# O docker stack deploy não lê .env sozinho.

# IP ou nome em que as portas 18080 (engine) e 13000 (Grafana) ficam acessíveis.
ONCALL_HOST=192.0.2.10
# Hostname do nó do Swarm onde a stack inteira roda (placement).
ONCALL_NODE=docker-node-1
# 0 até existir TELEGRAM_TOKEN de um bot sem outro consumidor de updates; depois 1.
TELEGRAM_POLLING_REPLICAS=0
